PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
FRONTEND_URL=http://localhost:3000

# Set to true to use mock data (no scrapers needed)
# Set to false to use real scrapers
USE_MOCK=true

# ScraperAPI key for bypassing anti-bot on OTA sites
# Free tier: 1000 calls/month — https://www.scraperapi.com
# Without this key scrapers run without proxy (may get blocked)
SCRAPER_API_KEY=your_scraperapi_key_here
